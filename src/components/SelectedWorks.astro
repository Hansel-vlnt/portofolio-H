      <p id="blueprint-dialog-category" class="font-mono-spec text-[0.72rem] font-bold text-[#035388]">
        Arsitektur Sistem
      </p>
      <h3 id="blueprint-dialog-title" class="font-extrabold text-[#091E36] text-lg truncate">
        Detail Proyek
      </h3>
    </div>
    <form method="dialog">
      <button
        type="submit"
        class="gel-btn gel-btn-pearl !min-h-[44px] !py-1.5 !px-3.5 !text-sm"
      >
        Tutup
      </button>
    </form>
  </div>

  <div class="p-5 sm:p-6 space-y-4 bg-gradient-to-b from-white to-[#F4FAFF] rounded-b-[15px]">
    <p id="blueprint-dialog-summary" class="prose-aero"></p>

    <div class="space-y-2">
      <h4 class="text-xs font-mono-spec font-bold uppercase tracking-wider text-[#035388]">
        Alur Teknis
      </h4>
      <ul
        id="blueprint-dialog-notes"
        class="space-y-2 text-sm font-medium text-[#091E36]"
      ></ul>
    </div>

    <div id="blueprint-dialog-stack" class="flex flex-wrap gap-1.5 pt-1"></div>

    <div class="pt-3 border-t border-[#CBE5FA] flex flex-wrap items-center justify-end gap-3">
      <a
        id="blueprint-dialog-repo"
        href="https://github.com/Hansel-vlnt"
        target="_blank"
        rel="noopener noreferrer"
        class="gel-btn gel-btn-cobalt"
      >
        Buka Repositori di GitHub
      </a>
    </div>
  </div>
</dialog>

<script
  type="application/json"
  id="ai-projects-json"
  set:html={JSON.stringify(AI_PROJECTS)}
/>

<script>
  import type { AiProject } from '../data/portfolio';

  const dataEl = document.getElementById('ai-projects-json');
  const projects: AiProject[] = dataEl?.textContent ? JSON.parse(dataEl.textContent) : [];
  const projectMap = new Map(projects.map((p) => [p.id, p]));

  const dialog = document.getElementById('blueprint-dialog') as HTMLDialogElement | null;
  const catEl = document.getElementById('blueprint-dialog-category');
  const titleEl = document.getElementById('blueprint-dialog-title');
  const summaryEl = document.getElementById('blueprint-dialog-summary');
  const notesEl = document.getElementById('blueprint-dialog-notes');
  const stackEl = document.getElementById('blueprint-dialog-stack');
  const repoEl = document.getElementById('blueprint-dialog-repo') as HTMLAnchorElement | null;

  document.querySelectorAll<HTMLButtonElement>('[data-open-project]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.openProject as AiProject['id'] | undefined;
      const project = id ? projectMap.get(id) : undefined;
      if (!project || !dialog) return;

      if (catEl) catEl.textContent = project.category;
      if (titleEl) titleEl.textContent = project.name;
      if (summaryEl) summaryEl.textContent = project.summary;
      if (repoEl) repoEl.href = project.repoUrl;

      if (notesEl) {
        notesEl.replaceChildren(
          ...project.architectureNotes.map((note) => {
            const li = document.createElement('li');
            li.className = 'flex items-start gap-2.5';
            const dot = document.createElement('span');
            dot.setAttribute('aria-hidden', 'true');
            dot.className = 'mt-1.5 w-1.5 h-1.5 rounded-full bg-[#0284C7] shrink-0';
            const text = document.createElement('span');
            text.textContent = note;
            li.append(dot, text);
            return li;
          })
        );
      }

      if (stackEl) {
        stackEl.replaceChildren(
          ...project.stack.map((tech) => {
            const chip = document.createElement('span');
            chip.className = 'spec-chip';
            chip.textContent = tech;
            return chip;
          })
        );
      }

      dialog.showModal();
    });
  });

  if (dialog && !('closedBy' in HTMLDialogElement.prototype)) {
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      const inside =
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width;
      if (!inside) dialog.close();
    });
  }
</script>
