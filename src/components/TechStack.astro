---
import { STACK_ROWS } from '../data/portfolio';
---

<section id="stack" class="py-10 sm:py-16">
  <div class="max-w-5xl mx-auto px-5 space-y-6">
    <div class="space-y-2 max-w-2xl">
      <h2 class="heading-section">Stack &amp; Perangkat</h2>
      <p class="prose-aero">
        Perangkat dan pustaka yang dipakai langsung pada keempat sistem AI di atas.
      </p>
    </div>

    <div class="acrylic-plate overflow-hidden">
      <div class="window-titlebar px-5 py-2.5 flex items-center justify-between gap-2">
        <span class="font-mono-spec text-xs font-bold text-[#091E36]">
          stack.aero
        </span>
        <span class="font-mono-spec text-xs font-semibold text-[#035388]">
          Python · MCP · Vision
        </span>
      </div>

      <dl class="divide-y divide-[#CBE5FA]">
        {
          STACK_ROWS.map((row) => (
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 sm:gap-6 px-5 sm:px-6 py-4 items-center">
              <dt class="sm:col-span-4 font-bold text-sm sm:text-[0.95rem] text-[#091E36]">
                {row.label}
              </dt>
              <dd class="sm:col-span-8 flex flex-wrap gap-2">
                {row.items.map((item) => (
                  <span class="spec-chip">{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
