---
import { PROFILE } from '../data/portfolio';
---

<section
  id="beranda"
  class="relative isolate pt-28 sm:pt-32 pb-12 sm:pb-18 overflow-hidden"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
    style="mask-image: linear-gradient(to bottom, #000 76%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, #000 76%, transparent 100%);"
  >
    <svg
      viewBox="0 0 1440 720"
      fill="none"
      preserveAspectRatio="xMidYMin slice"
      class="w-full h-full"
    >
      <defs>
        <linearGradient id="auroraSilkA" x1="0%" y1="15%" x2="100%" y2="65%">
          <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.5" />
          <stop offset="50%" stop-color="#FFFFFF" stop-opacity="0.92" />
          <stop offset="100%" stop-color="#4ADE80" stop-opacity="0.52" />
        </linearGradient>
        <linearGradient id="auroraSilkB" x1="100%" y1="0%" x2="0%" y2="85%">
          <stop offset="0%" stop-color="#0EA5E9" stop-opacity="0.38" />
          <stop offset="55%" stop-color="#E0F2FE" stop-opacity="0.75" />
          <stop offset="100%" stop-color="#86EFAC" stop-opacity="0.38" />
        </linearGradient>
        <radialGradient id="sunZenith" cx="78%" cy="16%" r="50%">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.98" />
          <stop offset="45%" stop-color="#7DD3FC" stop-opacity="0.45" />
          <stop offset="100%" stop-color="#BAE6FD" stop-opacity="0" />
        </radialGradient>
      </defs>

      <rect width="1440" height="720" fill="url(#sunZenith)" />

      <path
        d="M-120 340 C 260 100, 620 430, 1060 165 C 1250 68, 1410 115, 1560 80 L 1560 390 C 1290 420, 990 240, 620 460 C 310 620, 60 500, -120 470 Z"
        fill="url(#auroraSilkA)"
      />
      <path
        d="M-80 190 C 310 370, 740 25, 1180 235 C 1340 310, 1460 260, 1540 210 L 1540 305 C 1340 370, 1120 110, 680 305 C 330 455, 80 325, -80 280 Z"
        fill="url(#auroraSilkB)"
      />
      <path
        d="M-100 338 C 265 104, 622 426, 1062 167 C 1250 70, 1410 117, 1560 83"
        stroke="#FFFFFF"
        stroke-opacity="0.95"
        stroke-width="2.4"
      />
      <circle cx="1110" cy="116" r="92" stroke="#FFFFFF" stroke-opacity="0.7" stroke-width="1.6" />
      <circle cx="1110" cy="116" r="152" stroke="#FFFFFF" stroke-opacity="0.42" stroke-width="1.2" />
    </svg>

    <div class="orb-dew hidden sm:block absolute top-24 right-[6%] w-22 h-22 opacity-90"></div>
    <div class="orb-dew hidden md:block absolute bottom-6 left-[5%] w-14 h-14 opacity-85"></div>
  </div>

  <div class="max-w-5xl mx-auto px-5 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
    <div class="lg:col-span-7 space-y-4">
      <p class="font-mono-spec text-xs sm:text-sm font-bold text-[#035388]">
        {PROFILE.role} · {PROFILE.institution}
      </p>

      <h1 class="display-name">
        {PROFILE.fullName}
      </h1>

      <p class="text-base sm:text-lg font-bold text-[#091E36] leading-snug">
        {PROFILE.focus}
      </p>

      <p class="prose-aero max-w-xl">
        {PROFILE.bio}
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a href="#karya" class="gel-btn gel-btn-eco">
          <span>Lihat Karya AI</span>
        </a>
        <a
          href={PROFILE.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="gel-btn gel-btn-pearl"
        >
          <span>GitHub @{PROFILE.handle}</span>
        </a>
      </div>
    </div>

    <aside class="lg:col-span-5" aria-label="Profil Singkat Hansel Valent Evanthe">
      <div class="aero-hero-bezel">
        <div class="aero-bezel-inner overflow-hidden">
          <div class="window-titlebar px-4 py-2 flex items-center justify-between gap-2">
            <span class="font-mono-spec text-xs font-bold text-[#091E36]">
              profile.aero
            </span>
            <span class="font-mono-spec text-xs font-semibold text-[#035388]">
              @{PROFILE.handle}
            </span>
          </div>

          <div class="p-5 space-y-4">
            <div class="flex items-center gap-4">
              <div class="shrink-0 p-1 rounded-2xl border border-[#5AA9E2] bg-gradient-to-b from-white to-[#D8EEFD]">
                <img
                  id="hero-github-avatar"
                  src={PROFILE.avatarUrl}
                  alt={`Foto profil ${PROFILE.fullName}`}
                  width="76"
                  height="76"
                  fetchpriority="high"
                  class="w-[76px] h-[76px] rounded-xl object-cover bg-[#E0F2FE]"
                />
                <div
                  id="hero-avatar-fallback"
                  hidden
                  aria-hidden="true"
                  class="w-[76px] h-[76px] rounded-xl flex items-center justify-center font-extrabold text-xl text-white bg-[#035388]"
                >
                  HV
                </div>
              </div>

              <div class="min-w-0 space-y-0.5">
                <div class="font-extrabold text-base text-[#091E36]">
                  {PROFILE.fullName}
                </div>
                <div class="text-sm font-semibold text-[#035388]">
                  Medan, Indonesia
                </div>
                <div class="text-xs font-medium text-[#23415F]">
                  Universitas Negeri Medan
                </div>
              </div>
            </div>

            <div
              class="pt-3 border-t border-[#CBE5FA] flex items-center justify-between gap-3 text-xs"
              aria-live="polite"
            >
              <span id="github-sync-status" class="font-semibold text-[#23415F]">
                Memuat info GitHub...
              </span>
              <button
                type="button"
                id="retry-github-sync"
                hidden
                class="font-bold text-[#035388] underline underline-offset-2 min-h-[44px] px-2 cursor-pointer"
              >
                Muat Ulang
              </button>
              <span
                id="github-repo-pill"
                hidden
                class="spec-chip"
              >
                31 Public Repos
              </span>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>

<script>
  const avatarImg = document.getElementById('hero-github-avatar') as HTMLImageElement | null;
  const avatarFallback = document.getElementById('hero-avatar-fallback');

  if (avatarImg && avatarFallback) {
    avatarImg.addEventListener('error', () => {
      avatarImg.hidden = true;
      avatarFallback.hidden = false;
    });
  }

  const statusEl = document.getElementById('github-sync-status');
  const retryBtn = document.getElementById('retry-github-sync');
  const pillEl = document.getElementById('github-repo-pill');

  async function syncGitHub() {
    if (!statusEl || !retryBtn || !pillEl) return;
    statusEl.textContent = 'Memuat info GitHub...';
    retryBtn.hidden = true;
    pillEl.hidden = true;

    try {
      const response = await fetch('https://api.github.com/users/Hansel-vlnt', {
        headers: { Accept: 'application/vnd.github+json' },
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const profile = await response.json();

      statusEl.textContent = 'GitHub Aktif';
      if (typeof profile.public_repos === 'number') {
        pillEl.textContent = `${profile.public_repos} Public Repos`;
      }
      pillEl.hidden = false;
    } catch {
      statusEl.textContent = 'Mode luring · 31 repo publik';
      retryBtn.hidden = false;
    }
  }

  retryBtn?.addEventListener('click', syncGitHub);
  syncGitHub();
</script>
